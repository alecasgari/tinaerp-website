<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="{{ '/' | url }}">
      <img src="{{ '/assets/img/tina-logo-wide.png' | url }}" alt="{{ site.title }}" class="brand-logo" width="96" height="24">
    </a>

    <p class="header-slogan">
      <span class="slogan-brand">تینا</span><span class="slogan-mark">،</span>
      <span class="slogan-accent">راهکار شما!</span>
    </p>

    <nav id="site-nav" class="site-nav" aria-label="منوی اصلی">
      <ul>
        {% for item in site.nav %}
        <li>
          <a href="{{ item.href | url }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a>
        </li>
        {% endfor %}
      </ul>
      <a class="btn btn-primary btn-sm header-cta" href="{{ '/demo/' | url }}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 5v14l11-7L8 5z" fill="currentColor"/></svg>
        درخواست دمو
      </a>
    </nav>

    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-modal" aria-label="باز کردن منو">
      <svg class="nav-toggle-icon" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
        <rect class="nav-sq a" x="2" y="2" width="6" height="6" rx="1.5"/>
        <rect class="nav-sq b" x="12" y="2" width="6" height="6" rx="1.5"/>
        <rect class="nav-sq c" x="2" y="12" width="6" height="6" rx="1.5"/>
        <rect class="nav-sq d" x="12" y="12" width="6" height="6" rx="1.5"/>
      </svg>
    </button>
  </div>
</header>

<div id="nav-modal" class="nav-modal" hidden>
  <div class="nav-modal-backdrop" data-nav-close></div>
  <div class="nav-modal-panel" role="dialog" aria-modal="true" aria-label="منوی سایت">
    <div class="nav-modal-top">
      <img src="{{ '/assets/img/tina-logo-wide.png' | url }}" alt="{{ site.title }}" width="110" height="28">
      <button type="button" class="nav-modal-close" data-nav-close aria-label="بستن منو">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
    <p class="nav-modal-slogan">
      <span class="slogan-brand">تینا</span><span class="slogan-mark">،</span>
      <span class="slogan-accent">راهکار شما!</span>
    </p>
    <div class="nav-modal-grid">
      {% for item in site.nav %}
      <a class="nav-modal-btn" href="{{ item.href | url }}" {% if page.url == item.href %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </div>
    <a class="btn btn-primary nav-modal-cta" href="{{ '/demo/' | url }}">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 5v14l11-7L8 5z" fill="currentColor"/></svg>
      درخواست دمو
    </a>
    <div class="nav-modal-social" aria-label="شبکه‌های اجتماعی">
      <span class="social-ico" title="اینستاگرام" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
      </span>
      <span class="social-ico" title="لینکدین" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M8 10v7M8 7.5v.5M12 17v-4.5a2.5 2.5 0 015 0V17" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </span>
      <span class="social-ico" title="تلگرام" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M21 5L3 12.5l6 1.5L17 8l-6.5 8.5L18 20l3-15z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
      </span>
      <span class="social-ico" title="ایکس" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </span>
    </div>
    <div class="nav-modal-contact">
      <a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
  </div>
</div>
