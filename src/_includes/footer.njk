<footer class="site-footer">
  <div class="container footer-compact">
    <a class="footer-brand-inline" href="{{ '/' | url }}">
      <img src="{{ '/assets/img/tina-logo-wide.png' | url }}" alt="{{ site.title }}" width="88" height="22">
    </a>
    <nav class="footer-links" aria-label="لینک‌های پاورقی">
      <a href="{{ '/features/' | url }}">ویژگی‌ها</a>
      <a href="{{ '/pricing/' | url }}">قیمت</a>
      <a href="{{ '/demo/' | url }}">دمو</a>
      <a href="{{ '/docs/' | url }}">مستندات</a>
      <a href="{{ '/blog/' | url }}">بلاگ</a>
      <a href="{{ '/news/' | url }}">اخبار</a>
      <a href="{{ '/about/' | url }}">درباره</a>
      <a href="{{ '/contact/' | url }}">تماس</a>
    </nav>
    <div class="footer-meta">
      <a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a>
      <a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>© {{ site.title }} — همه حقوق محفوظ است</p>
  </div>
</footer>

<div class="float-actions" aria-label="میانبرهای شناور">
  <button type="button" class="float-btn float-top" id="back-to-top" hidden aria-label="بازگشت به بالا">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12l7-7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <a class="float-btn float-wa" href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener" aria-label="گفتگو در واتساپ">
