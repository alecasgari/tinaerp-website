---
layout: base.njk
---
{% set isComparison = page.url | startsWith("/alternatives/") %}
{% if isComparison %}
{% set crumbs = [{ label: title }] %}
{% else %}
{% set crumbs = [
  { label: "بلاگ", href: "/blog/" },
  { label: title }
] %}
{% endif %}
<article class="section post" itemscope itemtype="https://schema.org/BlogPosting">
  <div class="container narrow">
    {% include "breadcrumbs.njk" %}
    <p class="eyebrow">{% if isComparison %}راهنمای مقایسه{% else %}بلاگ{% endif %} · {{ site.title }}</p>
    <h1 class="post-title" itemprop="headline">{{ title }}</h1>
    <p class="post-meta">
      <time itemprop="datePublished" datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      {% if summary %} · <span itemprop="description">{{ summary }}</span>{% endif %}
    </p>
    {% if image %}
    <figure class="post-feature">
      <img
        src="{{ image | url }}"
        width="{{ ogImageWidth or site.ogImageWidth }}"
        height="{{ ogImageHeight or site.ogImageHeight }}"
        alt="{{ imageAlt or title }}"
        itemprop="image"
        loading="eager"
        decoding="async"
      >
    </figure>
    {% endif %}
    <div class="prose post-body" itemprop="articleBody">
      {{ content | safe }}
    </div>
    {% if faqs and faqs.length %}
    <section class="prose post-faq" aria-label="سوالات پرتکرار">
      <h2>سوالات پرتکرار</h2>
      {% for item in faqs %}
      <h3>{{ item.q }}</h3>
      <p>{{ item.a | safe }}</p>
      {% endfor %}
    </section>
    {% endif %}
    <p class="post-back"><a href="{{ '/blog/' | url }}">← بازگشت به بلاگ</a></p>
  </div>
</article>
