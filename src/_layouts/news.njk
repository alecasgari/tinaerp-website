---
layout: base.njk
---
<article class="section post post-news" itemscope itemtype="https://schema.org/NewsArticle">
  <div class="container narrow">
    <p class="eyebrow">اخبار · {{ site.title }}</p>
    <h1 class="post-title" itemprop="headline">{{ title }}</h1>
    <p class="post-meta">
      <time itemprop="datePublished">{{ date | readableDate }}</time>
      {% if summary %} · <span itemprop="description">{{ summary }}</span>{% endif %}
    </p>
    <div class="prose post-body" itemprop="articleBody">
      {{ content | safe }}
    </div>
    <p class="post-back"><a href="{{ '/news/' | url }}">← بازگشت به اخبار</a></p>
  </div>
</article>
